    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "playwright": "1.61.1",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
